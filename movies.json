    "Im5iZiI6MTc5MTM2MDAyNy4zMzQsInN1YiI6IjZhYzVmYzFiOGM4NWQzMmZhZmYyN2NiYSIsInNjb3BlcyI6WyJhcGlfcmVhZCJdLCJ2ZXJzaW9uIjoxfQ.G_VD8Slnl18KXmgxZI5dhBQCOM15QR5TzLgGq-8H9d8"
)

# Alag-alag endpoints ya trending data fetch karne ke liye
URL = "https://api.themoviedb.org/3/trending/movie/day"


def fetch_movies (  ) :
  req = urllib.request.Request(
      URL,
      headers={
          "Authorization": f"Bearer {BEARER_TOKEN}",
          "accept": "application/json",
      },
  )
  with urllib.request.urlopen ( req) as response:
    if response.status == 200:
      data = json.loads ( response.read (  ) .decode ( "utf-8" ) )
      movies_list = []
      for item in data.get ( "results", [] ) :
        title = item.get ( "title") or item.get ( "original_title", "Unknown")
        overview = item.get ( "overview", "" ) .lower ( )
        original_language = item.get ( "original_language", "")

        # Category automatic detect karne ka logic
        category = "hollywood"
        if (
            "marvel" in title.lower ( )
            or "avengers" in title.lower ( )
            or "spider" in title.lower ( )
            or "deadpool" in title.lower ( )
        ):
          category = "marvel"
        elif "disney" in overview or "animation" in overview:
          category = "disney"
        elif original_language == "hi":
          category = "bollywood"
        elif original_language in ["ta", "te", "ml", "kn"]:
          category = "south"

        movie_data = {
            "id": item.get ( "id" ) ,
            "title": title,
            "poster_path": (
                "https://image.tmdb.org/t/p/w500" + item.get ( "poster_path")
                if item.get ( "poster_path")
                else ""
            ),
            "backdrop_path": (
                "https://image.tmdb.org/t/p/w1280"
                + item.get ( "backdrop_path")
                if item.get ( "backdrop_path")
                else ""
            ),
            "category": category,
        }
        movies_list.append ( movie_data)

      with open ( "movies.json", "w", encoding="utf-8") as f:
        json.dump ( movies_list, f, ensure_ensure_ascii=False, indent=4)
      print ( f"Success! {len ( movies_list ) } movies saved with proper categories.")


if __name__ == "__main__":
  fetch_movies ( )
